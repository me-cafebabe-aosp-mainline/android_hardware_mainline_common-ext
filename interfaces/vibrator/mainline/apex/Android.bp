apex {
    name: "com.android.hardware.vibrator.mainline_ext",
    manifest: "apex_manifest.json",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    file_contexts: "file_contexts",
    updatable: false,
    vendor: true,

    binaries: [
        "android.hardware.vibrator-service.mainline_ext",
    ],
    prebuilts: [
        "vibrator-mainline_ext.rc",
        "android.hardware.vibrator.mainline_ext.xml",
    ],
}
