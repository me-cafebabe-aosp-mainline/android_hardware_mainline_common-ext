cc_library_static {
    name: "libvibratormainlineextimpl",
    vendor: true,
    shared_libs: [
        "android.hardware.vibrator-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    export_include_dirs: ["include"],
    srcs: [
        "VibrationSession.cpp",
        "Vibrator.cpp",
        "VibratorManager.cpp",
    ],
    visibility: [
        ":__subpackages__",
    ],
    installable: false,
}

prebuilt_etc {
    name: "vibrator-mainline_ext.rc",
    src: "vibrator-mainline.rc",
    installable: false,
}

prebuilt_etc {
    name: "android.hardware.vibrator.mainline_ext.xml",
    src: "android.hardware.vibrator.mainline.xml",
    sub_dir: "vintf",
    installable: false,
}

cc_binary {
    name: "android.hardware.vibrator-service.mainline_ext",
    relative_install_path: "hw",
    vendor: true,
    shared_libs: [
        "android.hardware.vibrator-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    static_libs: [
        "libvibratormainlineextimpl",
    ],
    srcs: ["main.cpp"],
    installable: false,
}
