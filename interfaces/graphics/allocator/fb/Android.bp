package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "fb_graphics_ext_buffer_sources",
    srcs: ["Buffer.cpp"],
}

filegroup {
    name: "fb_graphics_ext_allocator_sources",
    srcs: [
        "Allocator.cpp",
        "AllocatorService.cpp",
    ],
}

filegroup {
    name: "fb_graphics_ext_composer_sources",
    srcs: [
        "Composer.cpp",
        "ComposerClient.cpp",
        "ComposerService.cpp",
        "FbdevDevice.cpp",
    ],
}

cc_defaults {
    name: "fb_graphics_ext_defaults",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "gnu++20",
    vendor: true,
}

cc_defaults {
    name: "fb_graphics_ext_buffer_defaults",
    defaults: ["fb_graphics_ext_defaults"],
    srcs: [":fb_graphics_ext_buffer_sources"],
    shared_libs: [
        "android.hardware.graphics.allocator-V3-ndk",
        "android.hardware.graphics.common-V7-ndk",
        "libbase",
        "libcutils",
        "libdrm",
        "libgralloctypes",
        "libhidlbase",
        "liblog",
    ],
}

cc_binary {
    name: "android.hardware.graphics.allocator-service.fb_ext",
    defaults: ["fb_graphics_ext_buffer_defaults"],
    srcs: [":fb_graphics_ext_allocator_sources"],
    relative_install_path: "hw",
    init_rc: select(soong_config_variable("fb_graphics", "include_init_rc"), {
        false: [],
        default: ["android.hardware.graphics.allocator-service.fb_ext.rc"],
    }),
    vintf_fragments: select(soong_config_variable("fb_graphics", "include_vintf_fragments"), {
        false: [],
        default: ["android.hardware.graphics.allocator-service.fb_ext.xml"],
    }),
    shared_libs: [
        "android.hardware.graphics.mapper@4.0",
        "libbinder_ndk",
    ],
    static_libs: ["libaidlcommonsupport"],
}

cc_library_shared {
    name: "mapper.fb_ext",
    defaults: ["fb_graphics_ext_buffer_defaults"],
    srcs: ["Mapper.cpp"],
    compile_multilib: "both",
    vintf_fragments: select(soong_config_variable("fb_graphics", "include_vintf_fragments"), {
        false: [],
        default: ["mapper.fb_ext.xml"],
    }),
    header_libs: [
        "libimapper_providerutils",
        "libimapper_stablec",
    ],
    shared_libs: ["libsync"],
    relative_install_path: "hw",
}

cc_binary {
    name: "android.hardware.graphics.composer3-service.fb_ext",
    defaults: ["fb_graphics_ext_buffer_defaults"],
    srcs: [":fb_graphics_ext_composer_sources"],
    relative_install_path: "hw",
    init_rc: select(soong_config_variable("fb_graphics", "include_init_rc"), {
        false: [],
        default: ["android.hardware.graphics.composer3-service.fb_ext.rc"],
    }),
    vintf_fragments: select(soong_config_variable("fb_graphics", "include_vintf_fragments"), {
        false: [],
        default: ["android.hardware.graphics.composer3-service.fb_ext.xml"],
    }),
    shared_libs: [
        "android.hardware.common-V2-ndk",
        "android.hardware.graphics.composer3-V5-ndk",
        "libbinder_ndk",
        "libhardware",
        "libsync",
    ],
    static_libs: ["libaidlcommonsupport"],
}

prebuilt_etc {
    name: "fb_allocator_ext_apex_vintf",
    src: "android.hardware.graphics.allocator-service.fb_ext.xml",
    filename_from_src: true,
    sub_dir: "vintf",
    vendor: true,
    installable: false,
}

prebuilt_etc {
    name: "fb_mapper_ext_apex_vintf",
    src: "mapper.fb_ext.xml",
    filename_from_src: true,
    sub_dir: "vintf",
    vendor: true,
    installable: false,
}

prebuilt_etc {
    name: "fb_composer_ext_apex_vintf",
    src: "android.hardware.graphics.composer3-service.fb_ext.xml",
    filename_from_src: true,
    sub_dir: "vintf",
    vendor: true,
    installable: false,
}

genrule {
    name: "gen_fb_allocator_ext_apex_init_rc",
    srcs: ["android.hardware.graphics.allocator-service.fb_ext.rc"],
    out: ["android.hardware.graphics.allocator-service.fb_ext.apex.rc"],
    cmd: "sed -e 's%/vendor/bin/%/apex/com.android.hardware.graphics.allocator/bin/%' $(in) > $(out)",
}

genrule {
    name: "gen_fb_composer_ext_apex_init_rc",
    srcs: ["android.hardware.graphics.composer3-service.fb_ext.rc"],
    out: ["android.hardware.graphics.composer3-service.fb_ext.apex.rc"],
    cmd: "sed -e 's%/vendor/bin/%/apex/com.android.hardware.graphics.allocator/bin/%' $(in) > $(out)",
}

prebuilt_etc {
    name: "fb_allocator_ext_apex_init_rc",
    src: ":gen_fb_allocator_ext_apex_init_rc",
    filename_from_src: true,
    vendor: true,
}

prebuilt_etc {
    name: "fb_composer_ext_apex_init_rc",
    src: ":gen_fb_composer_ext_apex_init_rc",
    filename_from_src: true,
    vendor: true,
}

filegroup {
    name: "fb_graphics_ext_apex_file_contexts",
    srcs: ["fb-apex-file-contexts"],
}

filegroup {
    name: "fb_graphics_ext_apex_manifest",
    srcs: ["fb-apex-manifest.json"],
}

soong_config_module_type {
    name: "fb_ext_apex",
    module_type: "apex",
    config_namespace: "fb_graphics",
    bool_variables: [
        "RELEASE_SM_OPEN_DECLARED_PASSTHROUGH_HAL",
    ],
    properties: [
        "defaults",
    ],
}

fb_ext_apex {
    name: "com.android.hardware.graphics.allocator.fb_ext",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    file_contexts: ":fb_graphics_ext_apex_file_contexts",
    manifest: ":fb_graphics_ext_apex_manifest",
    updatable: false,
    vendor: true,

    binaries: [
        "android.hardware.graphics.allocator-service.fb_ext",
        "android.hardware.graphics.composer3-service.fb_ext",
    ],
    prebuilts: [
        "fb_allocator_ext_apex_init_rc",
        "fb_allocator_ext_apex_vintf",
        "fb_composer_ext_apex_init_rc",
        "fb_composer_ext_apex_vintf",
    ],
    overrides: [
        "android.hardware.graphics.allocator-service.fb_ext",
        "android.hardware.graphics.composer3-service.fb_ext",
    ],

    soong_config_variables: {
        RELEASE_SM_OPEN_DECLARED_PASSTHROUGH_HAL: {
            defaults: [
                "com.android.hardware.graphics.allocator.fb_ext-mapper-defaults",
            ],
            conditions_default: {},
        },
    },
}

apex_defaults {
    name: "com.android.hardware.graphics.allocator.fb_ext-mapper-defaults",

    // for app_process32 apps
    compile_multilib: "both",

    native_shared_libs: ["mapper.fb_ext"],
    prebuilts: [
        "fb_mapper_ext_apex_vintf",
        "fb_allocator_ext_apex_linker_config",
    ],
    overrides: [
        "mapper.fb_ext",
    ],
}

linker_config {
    name: "fb_allocator_ext_apex_linker_config",
    src: "fb-apex-linkerconfig.json",
    installable: false,
}
