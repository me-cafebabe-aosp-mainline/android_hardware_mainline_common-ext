cc_library_shared {
    name: "libsensors_ext_mock",
    vendor: true,
    srcs: ["MockBackend.cpp"],
    header_libs: ["libsensors_mainline_ext_headers"],
    static_libs: ["libsensors_ext_common"],
    shared_libs: [
        "android.hardware.sensors-V3-ndk",
        "libbase",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-fvisibility=hidden",
    ],
}
